<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
    <name>com_biotime</name>
    <author>ZKBioTime Portal</author>
    <authorUrl>https://github.com/aboarken/joomla-biotime</authorUrl>
    <creationDate>2026-11</creationDate>
    <copyright>(C) 2026</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>1.3.4</version>
    <description>COM_BIOTIME_XML_DESCRIPTION</description>
    <namespace path="src">BiotimePortal\Component\Biotime</namespace>

    <scriptfile>script.php</scriptfile>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
            <file driver="postgresql" charset="utf8">sql/install.postgresql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
            <file driver="postgresql" charset="utf8">sql/uninstall.postgresql.utf8.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
            <schemapath type="postgresql">sql/updates/postgresql</schemapath>
        </schemas>
    </update>

    <files folder="site">
        <folder>language</folder>
        <folder>layouts</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <media destination="com_biotime" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>js</folder>
    </media>

    <!-- Shown when the version is clicked in System > Manage > Extensions; built from CHANGELOG.md
         by build/make-changelog-xml.py and attached to every release. -->
    <changelogurl>https://github.com/aboarken/joomla-biotime/releases/latest/download/changelog.xml</changelogurl>

    <!-- Joomla checks this for updates (System > Update > Extensions). The file is attached to every
         GitHub release by .github/workflows/release.yml; "latest" always means the newest release. -->
    <updateservers>
        <server type="extension" priority="1" name="ZKBioTime">https://github.com/aboarken/joomla-biotime/releases/latest/download/updates.xml</server>
    </updateservers>

    <administration>
        <menu img="class:clock">COM_BIOTIME</menu>
        <submenu>
            <menu link="option=com_biotime&amp;view=integrationsettings">COM_BIOTIME_SUBMENU_SETTINGS</menu>
            <menu link="option=com_biotime&amp;view=usermappings">COM_BIOTIME_SUBMENU_MAPPINGS</menu>
            <menu link="option=com_biotime&amp;view=tables">COM_BIOTIME_SUBMENU_TABLES</menu>
        </submenu>
        <files folder="administrator">
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <folder>forms</folder>
            <folder>language</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <!-- The PDF library (mPDF and what it needs), copied by build/vendor-pdf.sh (1.2.0). -->
            <folder>vendor</folder>
        </files>
    </administration>
</extension>
