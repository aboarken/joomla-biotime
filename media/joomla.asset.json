{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "com_biotime",
  "version": "1.3.5",
  "description": "ZKBioTime attendance portal assets",
  "license": "GPL-2.0-or-later",
  "assets": [
    {
      "name": "com_biotime.admin",
      "type": "style",
      "uri": "com_biotime/admin.css",
      "version": "1.3.5"
    },
    {
      "name": "com_biotime.portal",
      "type": "style",
      "uri": "com_biotime/portal.css",
      "version": "1.3.5"
    },
    {
      "name": "com_biotime.filters",
      "type": "script",
      "uri": "com_biotime/filters.js",
      "attributes": {
        "defer": true
      },
      "version": "1.3.5"
    },
    {
      "name": "com_biotime.datepicker",
      "type": "script",
      "uri": "com_biotime/datepicker.js",
      "attributes": {
        "defer": true
      },
      "version": "1.3.5"
    },
    {
      "name": "com_biotime.report",
      "type": "script",
      "uri": "com_biotime/report.js",
      "attributes": {
        "defer": true
      },
      "version": "1.3.5"
    },
    {
      "name": "com_biotime.refresh",
      "type": "script",
      "uri": "com_biotime/refresh.js",
      "dependencies": [
        "core"
      ],
      "attributes": {
        "defer": true
      },
      "version": "1.3.5"
    }
  ]
}
